<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Dashboard Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- Financial Summary Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today"
                style="@style/TextAppearance.SMEBiz.Subtitle"
                android:layout_marginBottom="@dimen/spacing_md" />

            <!-- Today's Sales Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/corner_radius_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/today_s_sales"
                        style="@style/TextAppearance.SMEBiz.Body"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/todays_sales_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ZWL 0.00"
                        style="@style/TextAppearance.SMEBiz.Amount"
                        android:layout_marginTop="@dimen/spacing_xs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Today's Expenses Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/corner_radius_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/today_s_expenses"
                        style="@style/TextAppearance.SMEBiz.Body"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/todays_expenses_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ZWL 0.00"
                        style="@style/TextAppearance.SMEBiz.Amount"
                        android:layout_marginTop="@dimen/spacing_xs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Balances Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Balances"
                style="@style/TextAppearance.SMEBiz.Subtitle"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_md" />

            <!-- Cash Balance -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/corner_radius_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cash_balance"
                        style="@style/TextAppearance.SMEBiz.Body"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/cash_balance_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ZWL 0.00"
                        style="@style/TextAppearance.SMEBiz.Amount"
                        android:layout_marginTop="@dimen/spacing_xs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mobile Money Balance -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/corner_radius_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mobile_money_balance"
                        style="@style/TextAppearance.SMEBiz.Body"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/mobile_money_balance_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ZWL 0.00"
                        style="@style/TextAppearance.SMEBiz.Amount"
                        android:layout_marginTop="@dimen/spacing_xs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bank Balance -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/corner_radius_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bank_balance"
                        style="@style/TextAppearance.SMEBiz.Body"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/bank_balance_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ZWL 0.00"
                        style="@style/TextAppearance.SMEBiz.Amount"
                        android:layout_marginTop="@dimen/spacing_xs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Inventory Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inventory"
                style="@style/TextAppearance.SMEBiz.Subtitle"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_md" />

            <!-- Stock Value -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/corner_radius_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stock_value"
                        style="@style/TextAppearance.SMEBiz.Body"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/stock_value_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ZWL 0.00"
                        style="@style/TextAppearance.SMEBiz.Amount"
                        android:layout_marginTop="@dimen/spacing_xs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Low Stock Alerts -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl"
                app:cardCornerRadius="@dimen/corner_radius_md"
                app:cardBackgroundColor="@color/warning_orange">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/low_stock_alerts"
                        style="@style/TextAppearance.SMEBiz.Body"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/low_stock_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="@dimen/text_size_heading"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/spacing_xs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
