<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.SMEBizZimbabwe" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary_dark_green</item>
        <item name="colorPrimaryVariant">@color/primary_green</item>
        <item name="colorSecondary">@color/accent_gold</item>
        <item name="colorSecondaryVariant">@color/accent_gold_dark</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/primary_dark_green</item>
        
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        
        <!-- Component styling -->
        <item name="materialButtonStyle">@style/Widget.SMEBiz.Button</item>
        <item name="materialCardViewStyle">@style/Widget.SMEBiz.CardView</item>
    </style>
    
    <!-- Custom Button Style - Large touch targets -->
    <style name="Widget.SMEBiz.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="cornerRadius">@dimen/corner_radius_md</item>
        <item name="backgroundColor">@color/primary_dark_green</item>
        <item name="android:textColor">@color/white</item>
    </style>
    
    <!-- Card View Style -->
    <style name="Widget.SMEBiz.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/corner_radius_md</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardElevation">2dp</item>
    </style>
    
    <!-- Text Styles -->
    <style name="TextAppearance.SMEBiz.Heading" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/text_size_heading</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
    
    <style name="TextAppearance.SMEBiz.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
    
    <style name="TextAppearance.SMEBiz.Subtitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">@dimen/text_size_subtitle</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    
    <style name="TextAppearance.SMEBiz.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    
    <style name="TextAppearance.SMEBiz.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_size_xs</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    
    <!-- Amount/Currency Display Style -->
    <style name="TextAppearance.SMEBiz.Amount">
        <item name="android:textSize">@dimen/text_size_heading</item>
        <item name="android:textColor">@color/primary_dark_green</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
